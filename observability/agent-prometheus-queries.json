    "query": "min(up{namespace=\"demo-app\",platform_service=\"platform-api\"})"
  },
  "catalog_target_up": {
    "component": "catalog-service",
    "signal": "target_up",
    "query": "min(up{namespace=\"demo-app\",platform_service=\"catalog-service\"})"
  },
  "orders_target_up": {
    "component": "orders-service",
    "signal": "target_up",
    "query": "min(up{namespace=\"demo-app\",platform_service=\"orders-service\"})"
  },
  "platform_api_request_rate_5m": {
    "component": "platform-api",
    "signal": "request_rate_5m",
    "query": "platform:http_requests:rate5m{platform_service=\"platform-api\"}"
  },
  "catalog_request_rate_5m": {
    "component": "catalog-service",
    "signal": "request_rate_5m",
    "query": "platform:http_requests:rate5m{platform_service=\"catalog-service\"}"
  },
  "orders_request_rate_5m": {
    "component": "orders-service",
    "signal": "request_rate_5m",
    "query": "platform:http_requests:rate5m{platform_service=\"orders-service\"}"
  },
  "platform_api_error_ratio_5m": {
    "component": "platform-api",
    "signal": "error_ratio_5m",
    "query": "platform:http_error_ratio:5m{platform_service=\"platform-api\"}"
  },
  "platform_api_error_ratio_1h": {
    "component": "platform-api",
    "signal": "error_ratio_1h",
    "query": "platform:http_error_ratio:1h{platform_service=\"platform-api\"}"
  },
  "catalog_error_ratio_5m": {
    "component": "catalog-service",
    "signal": "error_ratio_5m",
    "query": "platform:http_error_ratio:5m{platform_service=\"catalog-service\"}"
  },
  "orders_error_ratio_5m": {
    "component": "orders-service",
    "signal": "error_ratio_5m",
    "query": "platform:http_error_ratio:5m{platform_service=\"orders-service\"}"
  },
  "platform_api_p95_latency_5m": {
    "component": "platform-api",
    "signal": "p95_latency_seconds_5m",
    "query": "platform:http_p95_latency_seconds:5m{platform_service=\"platform-api\"}"
  },
  "catalog_p95_latency_5m": {
    "component": "catalog-service",
    "signal": "p95_latency_seconds_5m",
    "query": "platform:http_p95_latency_seconds:5m{platform_service=\"catalog-service\"}"
  },
  "orders_p95_latency_5m": {
    "component": "orders-service",
    "signal": "p95_latency_seconds_5m",
    "query": "platform:http_p95_latency_seconds:5m{platform_service=\"orders-service\"}"
  },
  "platform_api_burn_rate_5m": {
    "component": "platform-api",
    "signal": "slo_burn_rate_5m",
    "query": "platform:slo_burn_rate:5m{platform_service=\"platform-api\"}"
  },
  "platform_api_burn_rate_1h": {
    "component": "platform-api",
    "signal": "slo_burn_rate_1h",
    "query": "platform:slo_burn_rate:1h{platform_service=\"platform-api\"}"
  },
  "platform_api_error_budget_remaining_6h": {
    "component": "platform-api",
    "signal": "error_budget_remaining_6h",
    "query": "platform:slo_error_budget_remaining:6h{platform_service=\"platform-api\"}"
  },
  "demo_ready_pods": {
    "component": "demo-app",
    "signal": "ready_pods",
    "query": "sum(kube_pod_status_ready{namespace=\"demo-app\",condition=\"true\"} == 1)"
  },
  "demo_restarts_1h": {
    "component": "demo-app",
    "signal": "container_restarts_1h",
    "query": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"demo-app\"}[1h]))"
  },
  "demo_hpa_saturation": {
    "component": "demo-app",
    "signal": "hpa_saturation",
    "query": "max(kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"demo-app\"} / clamp_min(kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"demo-app\"}, 1))"
  },
  "pending_pods": {
    "component": "kubernetes",
    "signal": "pending_pods",
    "query": "sum(kube_pod_status_phase{phase=\"Pending\"} == 1)"
  },
  "oomkilled_containers": {
    "component": "kubernetes",
    "signal": "oomkilled_containers",
    "query": "sum(kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"}) or vector(0)"
  },
  "envoy_live": {
    "component": "envoy-gateway",
    "signal": "proxy_live",
    "query": "min(envoy_server_live)"
  },
  "otel_sent_spans_5m": {
    "component": "otel-collector",
    "signal": "sent_spans_rate_5m",
    "query": "sum(rate(otelcol_exporter_sent_spans[5m]))"
  },
  "otel_failed_spans_5m": {
    "component": "otel-collector",
    "signal": "failed_spans_rate_5m",
    "query": "sum(rate(otelcol_exporter_send_failed_spans[5m]))"
  },
  "otel_refused_spans_5m": {
    "component": "otel-collector",
    "signal": "refused_spans_rate_5m",
    "query": "sum(rate(otelcol_receiver_refused_spans[5m]))"
  },
  "firing_alerts": {
    "component": "alerting",
    "signal": "firing_alerts",
    "query": "count(ALERTS{alertstate=\"firing\"}) or vector(0)"
  }
}
